# Copy to .env and fill in. NEVER commit .env. Every value here is a placeholder.

# --- Environment -------------------------------------------------------------
# development | staging | production. Controls safety switches below.
APP_ENV=development
APP_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Two roles, on purpose (see docs/ARCHITECTURE.md "Two database roles"):
#  - OWNER runs migrations and system tasks (job claiming, webhooks, sign-in lookups).
#  - APP is what web requests use. Row-level security is enforced on it.
DATABASE_OWNER_URL=postgres://replyline_owner:CHANGE_ME@localhost:5432/replyline
# The APP role must be named replyline_app (migrations grant to it). Create it once: see docs/SETUP.md.
DATABASE_URL=postgres://replyline_app:CHANGE_ME@localhost:5432/replyline

# --- Secrets -----------------------------------------------------------------
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
# Protects /api/cron/tick when you use an external scheduler instead of the worker.
CRON_SECRET=CHANGE_ME

# --- Email -------------------------------------------------------------------
# simulated = nothing leaves the server; messages appear in the in-app Outbox.
# resend    = real sending via Resend (requires a verified domain).
EMAIL_PROVIDER=simulated
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=replies@your-verified-domain.example
# Real sending is refused unless this is exactly "true", even with a provider configured.
ALLOW_REAL_EMAIL=false
# Shared secret for the inbound-email webhook (see docs/INTEGRATIONS.md).
INBOUND_EMAIL_SECRET=CHANGE_ME

# --- AI ----------------------------------------------------------------------
# mock = deterministic local drafts, no data leaves the server.
# anthropic = Claude via the Anthropic API.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Billing -----------------------------------------------------------------
# dev = plan changes apply instantly, no payment. stripe = real Stripe Checkout.
BILLING_PROVIDER=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
